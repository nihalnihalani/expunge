# Names only. Copy to ${EXPUNGE_ENV_DIR}/observer.env (mode 0600, not in the repository) and fill there.
# The evidence process holds the observer principal, the Raindrop write key and the SEPARATE Raindrop Query key.
MONGODB_OBSERVER_URI=
EXPUNGE_WORLD_DB=
EXPUNGE_CONTROL_DB=
EXPUNGE_TENANT_ID=
EXPUNGE_ENV=
EXPUNGE_SCOPE_ID=
RAINDROP_API_KEY=
RAINDROP_QUERY_API_KEY=
RAINDROP_PROJECT_ID=
RAINDROP_ORGANIZATION_ID=
# Leak guard exported by the privacy controller (0600 file, mounted read-only into the container).
EXPUNGE_LEAK_GUARD_FILE=
# Optional fixed observer window (UTC ISO, both or neither); without it only the outbox dispatcher runs.
EXPUNGE_OBSERVER_WINDOW_START=
EXPUNGE_OBSERVER_WINDOW_END=
EXPUNGE_OBSERVER_VERSION=
EXPUNGE_OBSERVER_EVENT_NAME=
