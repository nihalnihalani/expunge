# Names only. Copy to ${EXPUNGE_ENV_DIR}/worker.env on the node host (mode 0600, owner root, NOT in the repository) and fill there.
# The worker holds the domain_executor principal and nothing else: no setup, grader, promoter, approval or privacy URI.
MONGODB_DOMAIN_EXECUTOR_URI=
EXPUNGE_WORLD_DB=
EXPUNGE_CONTROL_DB=
EXPUNGE_TENANT_ID=
EXPUNGE_ENV=
EXPUNGE_SCOPE_ID=
# Operator-to-worker wake principal (at least 32 characters).
EXPUNGE_WAKE_TOKEN=
EXPUNGE_MODEL_PROVIDER=
EXPUNGE_MODEL_ID=
EXPUNGE_MODEL_PRICE_INPUT_MICROUSD_PER_MILLION=
EXPUNGE_MODEL_PRICE_OUTPUT_MICROUSD_PER_MILLION=
# Exactly one of the two provider keys, matching EXPUNGE_MODEL_PROVIDER.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional Raindrop episodes (write key only; the Query key belongs to the observer).
RAINDROP_API_KEY=
RAINDROP_PROJECT_ID=
EXPUNGE_WORKER_ID=
EXPUNGE_WORKER_LEASE_MS=
EXPUNGE_WORKER_MAX_CONCURRENT=
EXPUNGE_WORKER_MAX_QUEUED=
EXPUNGE_WORKER_PHASE_TIMEOUT_MS=
EXPUNGE_WORKER_POLL_MS=
EXPUNGE_WORKER_POLL_BATCH=
EXPUNGE_WORKER_TOOL_DRAIN_MS=
EXPUNGE_WORKER_REQUIRE_PRICING=
