# Candidate-only service configuration. Provide real random per-candidate
# secrets locally; do not put computer masters or database keys in this file.
EXPUNGE_CANDIDATE_ID=
EXPUNGE_CANDIDATE_DOT_ID=
# HMAC-SHA256(COMPUTER_TOKEN, 'opendots-computer:' + DOT_ID), derived server-side.
EXPUNGE_CANDIDATE_COMPUTER_TOKEN=
# A scoped short-lived candidate broker capability, distinct from child token.
EXPUNGE_CANDIDATE_ACCESS_TOKEN=
# Server-to-broker principal: proxy only, never forwarded into candidate env. This is NOT the operator's
# EXPUNGE_INTERNAL_TOKEN (its read-projection principal); the proxy refuses to start if that name is present.
EXPUNGE_CANDIDATE_BROKER_TOKEN=
# Optional: lowercase hex SHA-256 of the operator's EXPUNGE_INTERNAL_TOKEN, e.g.
#   printf %s "$EXPUNGE_INTERNAL_TOKEN" | shasum -a 256
EXPUNGE_OPERATOR_TOKEN_SHA256=
EXPUNGE_CANDIDATE_BROKER_ORIGIN=http://candidate-broker:4320
# Exact admitted method/path pairs from B2's trusted broker contract. Empty
# allows no outbound request. Internet/metadata/private routes stay denied.
EXPUNGE_CANDIDATE_ALLOWED_ROUTES=[]
EXPUNGE_BROKER_NETWORK=expunge-candidate-broker
EXPUNGE_CANDIDATE_PORT=4313
EXPUNGE_CANDIDATE_SUBNET=172.30.90.0/29
EXPUNGE_PROXY_IPV4=172.30.90.2
EXPUNGE_CANDIDATE_IPV4=172.30.90.3
