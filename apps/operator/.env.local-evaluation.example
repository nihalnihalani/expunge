# Local shell and domain evaluation with hosted Intelligence unset.
# The existing OpenDots chat remains in setup state until real Intelligence/model
# credentials are supplied. Local domain jobs run in apps/worker, not chat.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
OWNER_ID=expunge-owner
OWNER_TOKEN=
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CPK_INTELLIGENCE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
DO_NOT_TRACK=1
WEB_SEARCH_PROVIDER=disabled
# Leave unset to boot the standalone shell. A configured transport requires a
# nonempty 24+ character token; it does not establish backend readiness.
EXPUNGE_DOMAIN_URL=
EXPUNGE_INTERNAL_TOKEN=
