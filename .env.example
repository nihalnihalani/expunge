# Fill credentials locally. Never put setup/admin credentials in an agent sandbox.
MONGODB_SETUP_URI=
MONGODB_DOMAIN_EXECUTOR_URI=
MONGODB_OBSERVER_URI=
MONGODB_PROPOSER_URI=
MONGODB_GRADER_URI=
MONGODB_APPROVAL_ISSUER_URI=
MONGODB_PROMOTER_URI=
MONGODB_PROJECTION_READER_URI=
MONGODB_PRIVACY_CONTROLLER_URI=
MONGODB_FIXTURE_BUILDER_URI=
# Optional local replica-set test connection; real integration tests run only when set.
MONGODB_TEST_URI=
EXPUNGE_WORLD_DB=expunge_world
EXPUNGE_CONTROL_DB=expunge_control
EXPUNGE_PRIVATE_DB=expunge_private
EXPUNGE_TENANT_ID=demo
EXPUNGE_ENV=demo
EXPUNGE_SCOPE_ID=synthetic-company
EXPUNGE_AUTH_SECRET=
EXPUNGE_INTERNAL_SECRET=
EXPUNGE_INTERNAL_TOKEN=
# Separate principal for operator -> worker wake commands ({jobId, commandId} only); never the projection token.
EXPUNGE_WAKE_TOKEN=
# Operator -> domain write principals (server-only; each bound to a fixed owner/scope on the domain side).
EXPUNGE_JOB_WRITE_TOKEN=
EXPUNGE_APPROVAL_TOKEN=
# Expunge builds run with operator telemetry disabled unless this is explicitly 1.
EXPUNGE_ALLOW_TELEMETRY=
# Durable worker (apps/worker) tuning; all optional with safe defaults.
EXPUNGE_WORKER_ID=
EXPUNGE_WORKER_LEASE_MS=
EXPUNGE_WORKER_MAX_CONCURRENT=
EXPUNGE_WORKER_MAX_QUEUED=
EXPUNGE_WORKER_PHASE_TIMEOUT_MS=
EXPUNGE_WORKER_POLL_MS=
EXPUNGE_WORKER_POLL_BATCH=
EXPUNGE_WORKER_TOOL_DRAIN_MS=
# Set to 1 to fail a run closed when a cost ceiling exists and a model call has no price (PricingUnavailable).
EXPUNGE_WORKER_REQUIRE_PRICING=
EXPUNGE_WORKER_HOST=
EXPUNGE_WORKER_PORT=
# Set to 1 to run the live provider smoke test (needs a provider key); EXPUNGE_REQUIRE_LIVE_TESTS=1 makes missing credentials fail instead of skip.
EXPUNGE_LIVE_PROVIDER_SMOKE=
EXPUNGE_REQUIRE_LIVE_TESTS=
EXPUNGE_DOMAIN_URL=http://127.0.0.1:4320
EXPUNGE_OWNER_EMAIL=
EXPUNGE_ALLOWED_ORIGINS=http://localhost:3000
# Setup seeds (read by scripts/setup-mongo.ts): the owner authority floor hash and whether 'behavioral' mutations need a human grant (default: yes).
EXPUNGE_AUTHORITY_FLOOR_HASH=
EXPUNGE_BEHAVIORAL_REQUIRES_APPROVAL=
# OpenDots / CopilotKit / chosen model provider
CPK_INTELLIGENCE_API_KEY=
INTELLIGENCE_API_KEY=
OWNER_TOKEN=
OWNER_ID=owner
APP_ORIGIN=http://localhost:5173
CPK_TELEMETRY_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
EXPUNGE_MODEL_PROVIDER=openai
EXPUNGE_MODEL_ID=
EXPUNGE_MODEL_PRICE_INPUT_MICROUSD_PER_MILLION=
EXPUNGE_MODEL_PRICE_OUTPUT_MICROUSD_PER_MILLION=
# Raindrop ingestion and query credentials are separate.
RAINDROP_API_KEY=
RAINDROP_QUERY_API_KEY=
RAINDROP_PROJECT_ID=
RAINDROP_ORGANIZATION_ID=
# Docker computer host / candidate sandbox (server-only).
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
EXPUNGE_SANDBOX_BROKER_URL=
EXPUNGE_SANDBOX_ARTIFACT_URL=
# Candidate proxy -> broker token (never the operator principal); optional sha256 of the operator token so the proxy can refuse it.
EXPUNGE_CANDIDATE_BROKER_TOKEN=
EXPUNGE_OPERATOR_TOKEN_SHA256=
