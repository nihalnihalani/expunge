# Names only. Copy to ${EXPUNGE_ENV_DIR}/operator.env (mode 0600, not in the repository) and fill there.
# The operator holds NO Mongo URI. It reaches the domain service with EXPUNGE_INTERNAL_TOKEN (read), EXPUNGE_JOB_WRITE_TOKEN
# and EXPUNGE_APPROVAL_TOKEN. The domain service process is NOT PACKAGED (no entrypoint exists); see docs/runbooks/DEPLOY.md.
OWNER_ID=
OWNER_TOKEN=
APP_ORIGIN=
EXPUNGE_ALLOWED_ORIGINS=
EXPUNGE_DOMAIN_URL=
EXPUNGE_INTERNAL_TOKEN=
EXPUNGE_JOB_WRITE_TOKEN=
EXPUNGE_APPROVAL_TOKEN=
EXPUNGE_TENANT_ID=
EXPUNGE_ENV=
EXPUNGE_SCOPE_ID=
CPK_INTELLIGENCE_API_KEY=
CPK_TELEMETRY_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
COMPUTER_NAMESPACE=
EXPUNGE_ALLOW_TELEMETRY=
