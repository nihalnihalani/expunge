# Hosted Intelligence operator; copy locally, then provide real credentials.
# This file contains no secrets and does not create an Intelligence account.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
OWNER_ID=expunge-owner
OWNER_TOKEN=
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CPK_INTELLIGENCE_API_KEY=
CPK_TELEMETRY_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
DO_NOT_TRACK=1
WEB_SEARCH_PROVIDER=disabled
# Server-only read projection principal. Backend must bind OWNER_ID to its scope.
EXPUNGE_DOMAIN_URL=http://127.0.0.1:4320
EXPUNGE_INTERNAL_TOKEN=
# Optional pinned OpenBot supervisor for ordinary Dot computers.
COMPUTER_SUPERVISOR_URL=http://127.0.0.1:4312
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
COMPUTER_NAMESPACE=expunge
